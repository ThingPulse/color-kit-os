      "files": [
        {
          "objID": "2a217cfa-7526-43d3-9e6e-3f5480ac533a",
          "fileName": "screens.h",
          "template": "#ifndef EEZ_LVGL_UI_SCREENS_H\r\n#define EEZ_LVGL_UI_SCREENS_H\r\n\r\n//${eez-studio LVGL_INCLUDE}\r\n#include \"images.h\"\r\n\r\n#undef lv_obj_clear_flag\r\n#define lv_obj_clear_flag(obj, flag) lv_obj_remove_flag((obj), (lv_obj_flag_t)(flag))\r\n\r\n\r\n#ifdef __cplusplus\r\nextern \"C\" {\r\n#endif\r\n    \r\n\r\n    //${eez-studio LVGL_SCREENS_DECL}\r\n    //${eez-studio LVGL_SCREENS_DECL_EXT}\r\n\r\n\r\n#ifdef __cplusplus\r\n}\r\n#endif\r\n\r\n\r\n#endif /*EEZ_LVGL_UI_SCREENS_H*/\r\n\r\n\r\n  "
        },
        {
          "objID": "b33ff317-453c-45aa-eba8-6a5de4eec005",
          "fileName": "screens.cpp",
          "template": "#include <string.h>\n\n#include \"screens.h\"\n#include \"images.h\"\n#include \"fonts.h\"\n#include \"actions.h\"\n//#include \"vars.h\"\n#include \"styles.h\"\n//#include \"ui.h\"\n\n\n    \n//${eez-studio LVGL_SCREENS_DEF}\n//${eez-studio LVGL_SCREENS_DEF_EXT}\n\n"
        },
        {
          "objID": "11867b5b-df23-4b40-eb15-4479e8b70ca8",
          "fileName": "images.h",
          "template": "#ifndef EEZ_LVGL_UI_IMAGES_H\r\n#define EEZ_LVGL_UI_IMAGES_H\r\n\r\n//${eez-studio LVGL_INCLUDE}\r\n\r\n#ifdef __cplusplus\r\nextern \"C\" {\r\n#endif\r\n\r\n//${eez-studio LVGL_IMAGES_DECL}\r\n\r\nextern const lv_img_dsc_t img_undefined;\r\n\r\nconst void *getLvglImageByName(const char *name);\r\n\r\n#ifdef __cplusplus\r\n}\r\n#endif\r\n\r\n#endif /*EEZ_LVGL_UI_IMAGES_H*/"
        },
        {
          "objID": "bd0c655b-29b2-4694-d870-d43d9fa7d355",
          "fileName": "images.c",
          "template": "#include \"images.h\"\n\n#include <string.h>\n//${eez-studio LVGL_IMAGES_DEF}\n\nconst void *getLvglImageByName(const char *name) {\n    for (size_t imageIndex = 0; imageIndex < sizeof(images) / sizeof(ext_img_desc_t); imageIndex++) {\n        if (strcmp(images[imageIndex].name, name) == 0) {\n            return images[imageIndex].img_dsc;\n        }\n    }\n    return 0;\n}\n\nconst lv_img_dsc_t img_undefined = {\n    .header.w = 0,\n    .header.h = 0,\n    .header.cf = LV_COLOR_FORMAT_RAW_ALPHA,\n    .data_size = 0,\n    .data = NULL,\n};"
        },
        {
          "objID": "38647719-125a-4255-cdb6-9efa306a5f40",
          "fileName": "styles.h",
          "template": "#ifndef EEZ_LVGL_UI_STYLES_H\r\n#define EEZ_LVGL_UI_STYLES_H\r\n\r\n//${eez-studio LVGL_INCLUDE}\r\n\r\n#ifdef __cplusplus\r\nextern \"C\" {\r\n#endif\r\n\r\n//${eez-studio LVGL_STYLES_DECL}\r\n\r\n#ifdef __cplusplus\r\n}\r\n#endif\r\n\r\n#endif /*EEZ_LVGL_UI_STYLES_H*/"
        },
        {
          "objID": "e1d6572b-60fa-4843-d35b-c64cfb70ed9e",
          "fileName": "styles.c",
          "template": "#include \"styles.h\"\n#include \"images.h\"\n#include \"fonts.h\"\n\n//${eez-studio LVGL_STYLES_DEF}\n"
        },
        {
          "objID": "672eb5d7-d21c-49c9-9d22-196433495a88",
          "fileName": "fonts.h",
          "template": "#ifndef EEZ_LVGL_UI_FONTS_H\r\n#define EEZ_LVGL_UI_FONTS_H\r\n\r\n//${eez-studio LVGL_INCLUDE}\r\n\r\n#ifdef __cplusplus\r\nextern \"C\" {\r\n#endif\r\n\r\n//${eez-studio LVGL_FONTS_DECL}\r\n\r\n#ifdef __cplusplus\r\n}\r\n#endif\r\n\r\n#endif /*EEZ_LVGL_UI_FONTS_H*/"
        },
        {
          "objID": "bc972db7-b734-43a5-cf1b-076d364159e9",
          "fileName": "ui.h",
          "template": "#ifndef EEZ_LVGL_UI_GUI_H\n#define EEZ_LVGL_UI_GUI_H\n\n\n#endif // EEZ_LVGL_UI_GUI_H"
        },
        {
          "objID": "562fe5c1-24c7-4d90-95ef-8c5c9b89b684",
          "fileName": "ui.c",
          "template": "#if defined(EEZ_FOR_LVGL)\n\n\n#endif\n"
        },
        {
          "objID": "781312c0-89de-46e8-b3bf-7e519b3bf6fe",
          "fileName": "actions.h",
          "template": "#ifndef EEZ_LVGL_UI_EVENTS_H\r\n#define EEZ_LVGL_UI_EVENTS_H\r\n\r\n//${eez-studio LVGL_INCLUDE}\r\n\r\n#ifdef __cplusplus\r\nextern \"C\" {\r\n#endif\r\n\r\n//${eez-studio LVGL_ACTIONS_DECL}\r\n\r\n#ifdef __cplusplus\r\n}\r\n#endif\r\n\r\n#endif /*EEZ_LVGL_UI_EVENTS_H*/"
        }
